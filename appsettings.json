{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "my-topic",
    "GroupId": "forwarder-group"
  },
  "Forwarding": {
    "MaxConcurrency": 4,
    "RetryCount": 3,
    "RetryBaseSeconds": 1.0,
    "DefaultEndpoint": "dynamic:defaultAction",
    "Endpoints": {
      "order_created": "dynamic:order",
      "user_registered": "dynamic:user"
    }
  },
  "DynamicApi": {
    "BaseUrl": "http://localhost:6000",
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
